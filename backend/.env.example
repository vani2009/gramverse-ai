PROJECT_NAME="GramVerse AI Backend"
ENV=development
DEBUG=True

# Database Configuration (PostgreSQL + PostGIS)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gramverse_db

# Optional SQLite override for standalone offline local testing without PostgreSQL:
# DATABASE_URL=sqlite+aiosqlite:///./gramverse_dev.db

# Redis Caching
REDIS_URL=redis://localhost:6379/0

# Firebase Admin Service Account Key (Path to JSON)
# FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
